# ---------------------------------------------------------------------------
# Variables de entorno de EJEMPLO — cópialas a `.env` y rellena tu LLM_API_KEY.
# NUNCA versiones `.env` (la key va sólo en tu máquina / secrets).
# ---------------------------------------------------------------------------

# Proveedor LLM del chatbot (D5). Por defecto Groq (OpenAI-compatible).
# Los modelos se configuran SOLO aquí; el código no escribe ningún nombre fijo.
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=               # <-- TU key de Groq (https://console.groq.com). Sin esto el chat no funciona.
LLM_MODEL=                 # <-- modelo principal (p.ej. openai/gpt-oss-120b). Obligatorio.
LLM_MODEL_FALLBACK=        # <-- modelo de respaldo si el principal falla (429/5xx/timeout). Opcional.
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=900
LLM_TIMEOUT_S=60
CHAT_MAX_TOOL_ITER=5

# Ciclo y calendario (D2). 15 = sólo Q1; 30 = Q1+Q2.
DURACION_CICLO_DIAS=30
ANIO_REF=2026
MES_REF=3
